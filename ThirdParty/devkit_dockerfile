FROM docker.m.daocloud.io/gitea/runner-images:ubuntu-26.04-v26.11.16

# full 镜像默认非 root 用户（写 /etc/apt 等需 root）——显式切 root
USER root

ARG LLVM_VERSION=23
ARG GITHUB_PROXY=https://gh-proxy.com
ARG PASSWORD=ChangeMeDockerfile123!

ENV PASSWORD=${PASSWORD:-ChangeMeDockerfile123!} \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    GITHUB_PROXY=${GITHUB_PROXY} \
    NVM_DIR=/root/.nvm \
    NVM_NODEJS_ORG_MIRROR=https://npmmirror.com/mirrors/node \
    PATH=/root/.local/share/pnpm/bin:/root/.local/share/pnpm:/root/.cargo/bin:/root/.local/bin:/root/vcpkg:/usr/lib/llvm-${LLVM_VERSION}/bin:$PATH \
    VCPKG_ROOT=/root/vcpkg \
    CCACHE_DIR=/root/.ccache \
    RUSTUP_HOME=/root/.rustup \
    CARGO_HOME=/root/.cargo \
    RUSTUP_PERMIT_COPY_RENAME=1 \
        CCACHE_COMPRESS=1 \
    CCACHE_MAXSIZE=5G \
    CCACHE_COMPILERCHECK=content \
    XMAKE_ROOT="y" \
    CC=clang \
    CXX=clang++

# ── Layer 1: apt 源 + locale + 时区（极少变更）─────────────────────────────
RUN echo "deb http://mirrors.aliyun.com/ubuntu/ $(. /etc/os-release && echo $UBUNTU_CODENAME) main restricted universe multiverse" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/ubuntu/ $(. /etc/os-release && echo $UBUNTU_CODENAME)-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/ubuntu/ $(. /etc/os-release && echo $UBUNTU_CODENAME)-backports main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/ubuntu/ $(. /etc/os-release && echo $UBUNTU_CODENAME)-security main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo Asia/Shanghai > /etc/timezone

# ── Layer 2: 基础工具 + CI 运行工具（极少变更）────────────────────────────
# iproute2: HOSTGW 探测的 ip 命令；postgresql-client: init_test_db.sh 的 psql；
# protobuf-compiler: grpc-proto build.rs 的 protoc；
# docker-ce-cli + docker-compose-plugin: CD 在 devkit 里 docker build/compose（runner 挂 docker.sock）
RUN apt-get update -y && \
    apt-get install -y locales && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 && \
    apt-get install -y ca-certificates curl gnupg && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://mirrors.aliyun.com/docker-ce/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://mirrors.aliyun.com/docker-ce/linux/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update -y && \
    apt-get install -y \
        openssh-server ca-certificates curl wget git build-essential \
        ccache ninja-build pkg-config autoconf autoconf-archive automake \
        libtool libssl-dev zlib1g-dev gdb gdbserver rsync libmpfr-dev \
        libgmp3-dev libmpc-dev bison flex procps lsb-release gnupg zsh \
        fish libmariadb-dev libmariadb-dev-compat \
        cmake python3-dev python3-pip \
        libpng-dev libjpeg-dev libwebp-dev libffi-dev \
        libsqlite3-dev libzstd-dev libbz2-dev uuid-dev libcap-dev liblzma-dev \
        iproute2 postgresql-client protobuf-compiler libprotobuf-dev \
        docker-ce-cli docker-compose-plugin && \
    apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    RUSTUP_DIST_SERVER=https://rsproxy.cn \
    RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup

# ── Layer 3: LLVM 工具链（独立层，版本升级才重建）────────────────────────
RUN LLVM_CODENAME=$(. /etc/os-release && echo $VERSION_CODENAME) && \
    echo "deb [trusted=yes] https://mirrors.tuna.tsinghua.edu.cn/llvm-apt/${LLVM_CODENAME}/ llvm-toolchain-${LLVM_CODENAME}-${LLVM_VERSION} main" > /etc/apt/sources.list.d/llvm.list && \
    apt-get update -y && apt-get install -y \
        clang-${LLVM_VERSION} \
        lldb-${LLVM_VERSION} \
        lld-${LLVM_VERSION} \
        libc++-${LLVM_VERSION}-dev \
        libc++abi-${LLVM_VERSION}-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-${LLVM_VERSION} 100 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-${LLVM_VERSION} 100

# ── Layer 4: SSH 配置（不变）─────────────────────────────────────────────
RUN ssh-keygen -A && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    chmod 600 /etc/shadow && chmod 600 /etc/ssh/*_key && \
    mkdir -p /run/sshd && chmod 755 /run/sshd

# ── Layer 5: Node.js + pnpm + Quasar（Node 版本变更才重建）─────────────────
# nvm 安装 Node.js（gh-proxy 加速），再由 nvm 环境装 npm + pnpm
ARG NODE_VERSION=26.13.1
RUN curl -fsSL "${GITHUB_PROXY}/https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh" | bash && \
    export NVM_DIR=/root/.nvm && . "$NVM_DIR/nvm.sh" && \
    nvm install ${NODE_VERSION} && nvm alias default ${NODE_VERSION} && \
    node --version && npm --version && \
    ln -sf "$NVM_DIR/versions/node/v${NODE_VERSION}/bin/node" /usr/local/bin/node && \
    ln -sf "$NVM_DIR/versions/node/v${NODE_VERSION}/bin/npm" /usr/local/bin/npm && \
    ln -sf "$NVM_DIR/versions/node/v${NODE_VERSION}/bin/npx" /usr/local/bin/npx && \
    npm config set registry https://registry.npmmirror.com && \
    curl -fsSL https://get.pnpm.io/install.sh | sed "s|https://github.com|${GITHUB_PROXY}/https://github.com|g" | SHELL=/bin/bash sh - && \
    export PNPM_HOME=/root/.local/share/pnpm && \
    export PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH" && \
    hash -r && pnpm --version && \
    pnpm config set registry https://registry.npmmirror.com && \
    pnpm add -g @quasar/cli && pnpm add -g turbo @tarojs/cli && \
    export PATH="$(pnpm bin -g):$PATH" && hash -r


# ── Layer 5.5: Flutter + Android SDK（移动端构建工具链）──────────────────
# Flutter stable + Microsoft OpenJDK 25.0.5.0.2 + Android SDK 34（国内镜像加速）。
# 用于 portal 小程序打包 APK / Flutter 混编。
ARG JDK_VERSION=25.0.5.0.2
RUN apt-get update && apt-get install -y --no-install-recommends \
        unzip \
        xz-utils \
        curl \
        git && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL -o /tmp/jdk.tar.gz https://aka.ms/download-jdk/microsoft-jdk-${JDK_VERSION}-linux-x64.tar.gz && \
    mkdir -p /opt/java && tar -xzf /tmp/jdk.tar.gz -C /opt/java --strip-components=1 && rm /tmp/jdk.tar.gz && \
    ln -sf /opt/java/bin/java /usr/local/bin/java && \
    ln -sf /opt/java/bin/javac /usr/local/bin/javac && \
    ln -sf /opt/java/bin/jar /usr/local/bin/jar && \
    java -version

ENV JAVA_HOME=/opt/java

# Android SDK（cmdline-tools + platform-tools + build-tools + platforms）
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    curl -fsSL -o /tmp/cmdline-tools.zip \
        https://mirrors.cloud.tencent.com/AndroidSDK/commandlinetools-linux-11076708_latest.zip && \
    unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip
ENV PATH=${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}
# Android SDK 组件（混合：platform-tools/build-tools 腾讯云 zip + platforms 走 sdkmanager）
RUN mkdir -p ${ANDROID_HOME}/platforms ${ANDROID_HOME}/build-tools && \
    cd /tmp && \
    curl -fsSL -o platform-tools.zip \
        https://mirrors.cloud.tencent.com/AndroidSDK/platform-tools-latest-linux.zip && \
    unzip -q platform-tools.zip -d ${ANDROID_HOME} && rm platform-tools.zip && \
    curl -fsSL -o build-tools.zip \
        https://mirrors.cloud.tencent.com/AndroidSDK/build-tools_r34-linux.zip && \
    unzip -q build-tools.zip -d /tmp/bt && mv /tmp/bt/android-* ${ANDROID_HOME}/build-tools/34.0.0 && rm -rf /tmp/bt build-tools.zip && \
    yes | sdkmanager --sdk_root=${ANDROID_HOME} --licenses >/dev/null 2>&1 || true; \
    sdkmanager --sdk_root=${ANDROID_HOME} "platforms;android-34" || true

# Flutter（stable——国内镜像）
ENV FLUTTER_HOME=/opt/flutter \
    PUB_HOSTED_URL=https://pub.flutter-io.cn \
    FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn
RUN git clone --depth 1 -b stable ${GITHUB_PROXY}/https://github.com/flutter/flutter.git ${FLUTTER_HOME} && \
    ${FLUTTER_HOME}/bin/flutter config --no-analytics && \
    ${FLUTTER_HOME}/bin/flutter precache
ENV PATH=${FLUTTER_HOME}/bin:${PATH}

# ── Layer 6: Rust 工具链（不变）──────────────────────────────────────────
# 下载 rustup-init 二进制后直接执行（不走 sh.rustup.rs 脚本，境内 DNS 常挂）
RUN curl -fsSL -o /tmp/rustup-init https://rsproxy.cn/rustup/dist/x86_64-unknown-linux-gnu/rustup-init && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y \
        --profile minimal \
        --default-toolchain stable \
        --target x86_64-unknown-linux-musl && \
    rm /tmp/rustup-init && \
    echo '[source.crates-io]' > ${CARGO_HOME}/config.toml && \
    echo "replace-with = 'rsproxy-sparse'" >> ${CARGO_HOME}/config.toml && \
    echo '[source.rsproxy-sparse]' >> ${CARGO_HOME}/config.toml && \
    echo "registry = 'sparse+https://rsproxy.cn/index/'" >> ${CARGO_HOME}/config.toml

# ── Layer 7: CI 门禁预装（pip + cargo-audit，每次 CI 跳过安装）──────────
# 这层是本次优化的核心：原来每个 CI job 都要跑 pip install + cargo install，
# cargo-audit 编译 2+ 分钟。预装进镜像后 CI 直接调用。
COPY Backend/tests/requirements.txt /tmp/requirements.txt
RUN pip3 install --break-system-packages -i https://pypi.tuna.tsinghua.edu.cn/simple -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt && \
    pip3 install --break-system-packages -i https://pypi.tuna.tsinghua.edu.cn/simple sqlglot

# ── Layer 8: sccache（rust 编译缓存——CI/CD 加速核心）──────────────────
# ccache 对 rust 无效（rustc 不走 gcc），sccache 是 rust 专用编译缓存。
# 预装后 CI 编译可复用缓存（比冷编译快 3-10 倍）。
RUN cargo install sccache --locked && \
    echo '[build]' >> ${CARGO_HOME}/config.toml && \
    echo 'rustc-wrapper = "/root/.cargo/bin/sccache"' >> ${CARGO_HOME}/config.toml

RUN cargo install cargo-audit --locked && \
    # advisory-db 预拉（CI 里 timeout 240 拉不下来就跳过，预拉后秒回）
    git config --global url."${GITHUB_PROXY}/https://github.com/".insteadOf "https://github.com/" && \
    cargo audit --version && \
    # 预拉 advisory-db 到 ~/.cargo/advisory-db
    git clone --depth 1 ${GITHUB_PROXY}/https://github.com/RustSec/advisory-db.git /root/.cargo/advisory-db 2>/dev/null || true

# ── Layer 8: xmake（独立层）──────────────────────────────────────────────
RUN git clone --depth 1 ${GITHUB_PROXY}/https://github.com/xmake-io/xmake.git && \
    cd xmake && ./scripts/get.sh __local__ && cd .. && rm -rf xmake

# ── Layer 9: vcpkg（独立层）──────────────────────────────────────────────
RUN cd /root && \
    git clone --depth 1 ${GITHUB_PROXY}/https://github.com/microsoft/vcpkg.git && \
    cd vcpkg && \
    sed -i "s|https://github.com|${GITHUB_PROXY}/https://github.com|g" ./scripts/bootstrap.sh && \
    sed -i "s|https://raw.githubusercontent.com|${GITHUB_PROXY}/https://raw.githubusercontent.com|g" ./scripts/bootstrap.sh && \
    ./bootstrap-vcpkg.sh && git reset --hard && \
    ln -s /root/vcpkg/vcpkg /usr/local/bin/vcpkg && \
    /root/vcpkg/vcpkg integrate install

# ── Layer 10: code-server（独立层）────────────────────────────────────────
# 直接下载 code-server 二进制（code-server.dev 在境内 SSL 超时）
ARG CS_VERSION=4.145.2
RUN curl -fsSL -o /tmp/cs.tar.gz "${GITHUB_PROXY}/https://github.com/coder/code-server/releases/download/v${CS_VERSION}/code-server-${CS_VERSION}-linux-amd64.tar.gz" && \
    tar -xzf /tmp/cs.tar.gz -C /opt && \
    mv /opt/code-server-${CS_VERSION}-linux-amd64 /opt/code-server && \
    ln -s /opt/code-server/bin/code-server /usr/local/bin/code-server && \
    rm /tmp/cs.tar.gz && \
    code-server --version

# ── Layer 11: ccache 软链 + entrypoint（不变）─────────────────────────────
RUN mkdir -p /root/.ccache && \
    ln -s /usr/bin/ccache /usr/local/bin/gcc && \
    ln -s /usr/bin/ccache /usr/local/bin/g++ && \
    ln -s /usr/bin/ccache /usr/local/bin/clang && \
    ln -s /usr/bin/ccache /usr/local/bin/clang++

RUN printf '#!/usr/bin/env bash\n\
set -e\n\
printf "root:%%s\\n" "$PASSWORD" | chpasswd\n\
mkdir -p /root/.config/code-server\n\
cat > /root/.config/code-server/config.yaml <<EOF\n\
bind-addr: 0.0.0.0:3000\n\
auth: password\n\
password: ${PASSWORD}\n\
cert: false\n\
EOF\n\
/usr/sbin/sshd -D -e &\n\
exec code-server\n' > /root/entrypoint.sh && \
    chmod +x /root/entrypoint.sh

LABEL maintainer="canplay <canplay@vip.qq.com>"
EXPOSE 22
EXPOSE 3000
ENTRYPOINT ["/root/entrypoint.sh"]
