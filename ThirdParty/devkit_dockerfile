FROM docker.gitea.com/runner-images:ubuntu-latest AS builder

ARG LLVM_VERSION=22
ARG GITHUB_PROXY=https://gh-proxy.com
ARG PASSWORD=ChangeMeDockerfile123!

ENV PASSWORD=${PASSWORD:-ChangeMeDockerfile123!} \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    GITHUB_PROXY=${GITHUB_PROXY} \
    NVM_DIR=/root/.nvm \
    NVM_NODEJS_ORG_MIRROR=https://npmmirror.com/mirrors/node \
    PATH=$NVM_DIR:/root/.cargo/bin:/root/.local/bin:/root/vcpkg:/usr/lib/llvm-${LLVM_VERSION}/bin:$PATH \
    VCPKG_ROOT=/root/vcpkg \
    CCACHE_DIR=/root/.ccache \
    RUSTUP_HOME=/root/.rustup \
    CARGO_HOME=/root/.cargo \
    RUSTUP_PERMIT_COPY_RENAME=1 \
    RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup \
    RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup \
    CCACHE_COMPRESS=1 \
    CCACHE_MAXSIZE=5G \
    CCACHE_COMPILERCHECK=content \
    XMAKE_ROOT="y" \
    CC=clang \
    CXX=clang++

RUN echo "deb http://mirrors.aliyun.com/ubuntu/ $(. /etc/os-release && echo $UBUNTU_CODENAME) main restricted universe multiverse" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/ubuntu/ $(. /etc/os-release && echo $UBUNTU_CODENAME)-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/ubuntu/ $(. /etc/os-release && echo $UBUNTU_CODENAME)-backports main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/ubuntu/ $(. /etc/os-release && echo $UBUNTU_CODENAME)-security main restricted universe multiverse" >> /etc/apt/sources.list

RUN apt-get update -y && apt-get install -y locales && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

RUN ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo Asia/Shanghai > /etc/timezone && \
    UBUNTU_CODENAME=$(. /etc/os-release && echo $UBUNTU_CODENAME) && \
    wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor > /etc/apt/trusted.gpg.d/llvm.gpg && \
    echo "deb https://mirrors.tuna.tsinghua.edu.cn/llvm-apt/${UBUNTU_CODENAME}/ llvm-toolchain-${UBUNTU_CODENAME}-${LLVM_VERSION} main" > /etc/apt/sources.list.d/llvm.list && \
    apt-get update -y && apt-get install -y \
        clang-${LLVM_VERSION} \
        lldb-${LLVM_VERSION} \
        lld-${LLVM_VERSION} \
        libc++-${LLVM_VERSION}-dev \
        libc++abi-${LLVM_VERSION}-dev \
        openssh-server ca-certificates curl wget git build-essential \
        ccache ninja-build pkg-config autoconf autoconf-archive automake \
        libtool libssl-dev zlib1g-dev gdb gdbserver rsync libmpfr-dev \
        libgmp3-dev libmpc-dev bison flex procps lsb-release gnupg zsh \
        fish libmariadb-dev libmariadb-dev-compat && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-${LLVM_VERSION} 100 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-${LLVM_VERSION} 100

RUN ssh-keygen -A && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    chmod 600 /etc/shadow && \
    chmod 600 /etc/ssh/*_key && \
    mkdir -p /run/sshd && \
    chmod 755 /run/sshd

RUN curl -o- ${GITHUB_PROXY}/https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash && \
    sed -i "s|https://github.com|${GITHUB_PROXY}/https://github.com|g" $NVM_DIR/nvm.sh && \
    sed -i "s|https://raw.githubusercontent.com|${GITHUB_PROXY}/https://raw.githubusercontent.com|g" $NVM_DIR/nvm.sh && \
    . $NVM_DIR/nvm.sh && nvm install 24 && nvm use 24 && \
    npm config set registry https://registry.npmmirror.com && \
    npm install -g pnpm && \
    export PATH="$PATH:/root/.local/share/pnpm/bin" && \
    pnpm config set registry https://registry.npmmirror.com && \
    pnpm add -g @quasar/cli

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
        --profile minimal \
        --default-toolchain stable \
        --target x86_64-unknown-linux-musl && \
    mkdir -p ${CARGO_HOME} && \
    echo '[source.crates-io]' > ${CARGO_HOME}/config.toml && \
    echo "replace-with = 'ustc'" >> ${CARGO_HOME}/config.toml && \
    echo '[source.ustc]' >> ${CARGO_HOME}/config.toml && \
    echo "registry = 'https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/'" >> ${CARGO_HOME}/config.toml

RUN git clone --depth 1 ${GITHUB_PROXY}/https://github.com/xmake-io/xmake.git && \
    cd xmake && \
    ./scripts/get.sh __local__ && cd .. && rm -rf xmake

RUN cd /root && \
    git clone --depth 1 ${GITHUB_PROXY}/https://github.com/microsoft/vcpkg.git && \
    cd vcpkg && \
    sed -i "s|https://github.com|${GITHUB_PROXY}/https://github.com|g" ./scripts/bootstrap.sh && \
    sed -i "s|https://raw.githubusercontent.com|${GITHUB_PROXY}/https://raw.githubusercontent.com|g" ./scripts/bootstrap.sh && \
    ./bootstrap-vcpkg.sh && \
    git reset --hard && \
    ln -s /root/vcpkg/vcpkg /usr/local/bin/vcpkg

RUN cd /root && \
    curl -fsSL https://code-server.dev/install.sh -o install.sh && \
    sed -i "s|https://github.com/coder/code-server|${GITHUB_PROXY}/https://github.com/coder/code-server|g" install.sh && \
    bash ./install.sh --version 4.90.0 && \
    rm -f ./install.sh && \
    rm -rf /root/.cache/code-server


# RUN git config --system --unset url."${GITHUB_PROXY}/github.com/".insteadOf

RUN /root/vcpkg/vcpkg integrate install && \
    mkdir -p /root/.ccache && \
    ln -s /usr/bin/ccache /usr/local/bin/gcc && \
    ln -s /usr/bin/ccache /usr/local/bin/g++ && \
    ln -s /usr/bin/ccache /usr/local/bin/clang && \
    ln -s /usr/bin/ccache /usr/local/bin/clang++

RUN printf '#!/usr/bin/env bash\n\
echo "root:${PASSWORD}" | chpasswd\n\
/usr/sbin/sshd -D -e &\n\
exec code-server --bind-addr 0.0.0.0:3000 --auth password\n' > /root/entrypoint.sh && \
    chmod +x /root/entrypoint.sh

LABEL maintainer="canplay <canplay@vip.qq.com>"
EXPOSE 22
EXPOSE 3000
CMD ["/root/entrypoint.sh"]