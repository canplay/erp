#-----------------------Backend Config------------------------------#
# Prisma Config
DATABASE_URL=postgresql://hoppscotch:56b74cb95d55f7b29a091a41@172.18.0.9:5432/hoppscotch

# (Optional) By default, the AIO container (when in subpath access mode) exposes the endpoint on port 80. Use this setting to specify a different port if needed.
HOPP_AIO_ALTERNATE_PORT=80

# Auth Tokens Config
JWT_SECRET="7b39ee83e558f291cbb46f6291f2b399"
TOKEN_SALT_COMPLEXITY=10
MAGIC_LINK_TOKEN_VALIDITY= 3
REFRESH_TOKEN_VALIDITY=604800000 # Default validity is 7 days (604800000 ms) in ms
ACCESS_TOKEN_VALIDITY=86400000 # Default validity is 1 day (86400000 ms) in ms
SESSION_SECRET="d91512782ff8be81e57463b29df8c512"
# Recommended to be true. Set to false if you are using http.
# Note: Some auth providers may not support http requests and may stop working when set to false.
ALLOW_SECURE_COOKIES=true

# Sensitive Data Encryption Key while storing in Database (32 character)
DATA_ENCRYPTION_KEY="0ab2cf1f68c7ee154d9e9d69aeb16b7c"

# Hoppscotch App Domain Config
REDIRECT_URL=https://post.cm.example.com
WHITELISTED_ORIGINS=https://post.cm.example.com
VITE_ALLOWED_AUTH_PROVIDERS=GITHUB,MICROSOFT,EMAIL

# Google Auth Config
GOOGLE_CLIENT_ID=5af4aed95c47ffe5bec0
GOOGLE_CLIENT_SECRET=5af4aed95c47ffe5bec0e7335232a758788a90c2
GOOGLE_CALLBACK_URL=https://post.cm.example.com/backend/v1/auth/google/callback
GOOGLE_SCOPE=email,profile

# Github Auth Config
GITHUB_CLIENT_ID=cabcd54d5bf61995d186
GITHUB_CLIENT_SECRET=cabcd54d5bf61995d186811bf2e9b73c992f0234
GITHUB_CALLBACK_URL=https://post.cm.example.com/backend/v1/auth/github/callback
GITHUB_SCOPE=user:email

# Microsoft Auth Config
MICROSOFT_CLIENT_ID=************************************************
MICROSOFT_CLIENT_SECRET=************************************************
MICROSOFT_CALLBACK_URL=https://post.cm.example.com/backend/v1/auth/microsoft/callback
MICROSOFT_SCOPE=user.read
MICROSOFT_TENANT=common

# Mailer config
MAILER_SMTP_ENABLE=false
MAILER_USE_CUSTOM_CONFIGS=false
MAILER_ADDRESS_FROM=<from@example.com>

MAILER_SMTP_URL="smtps://user@domain.com:pass@smtp.domain.com" # used if custom mailer configs is false

# The following are used if custom mailer configs is true
MAILER_SMTP_HOST=smtp.domain.com
MAILER_SMTP_PORT=587
MAILER_SMTP_SECURE=true
MAILER_SMTP_USER=user@domain.com
MAILER_SMTP_PASSWORD=pass
MAILER_TLS_REJECT_UNAUTHORIZED=true

# Rate Limit Config
RATE_LIMIT_TTL=60 # In seconds
RATE_LIMIT_MAX=100 # Max requests per IP


#-----------------------Frontend Config------------------------------#


# Base URLs
VITE_BASE_URL=https://post.cm.example.com
VITE_SHORTCODE_BASE_URL=https://post.cm.example.com
VITE_ADMIN_URL=https://post.cm.example.com/admin

# Backend URLs
VITE_BACKEND_GQL_URL=https://post.cm.example.com/backend/graphql
VITE_BACKEND_WS_URL=wss://post.cm.example.com/backend/graphql
VITE_BACKEND_API_URL=https://post.cm.example.com/backend/v1

# Terms Of Service And Privacy Policy Links (Optional)
VITE_APP_TOS_LINK=https://docs.hoppscotch.io/support/terms
VITE_APP_PRIVACY_POLICY_LINK=https://docs.hoppscotch.io/support/privacy

# Set to `true` for subpath based access
ENABLE_SUBPATH_BASED_ACCESS=true
